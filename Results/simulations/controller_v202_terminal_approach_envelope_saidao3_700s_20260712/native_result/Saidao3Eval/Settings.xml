<Settings>
    <StartTime>0</StartTime>
    <StopTime>700</StopTime>
    <Integration>
        <Algorithm>Dassl</Algorithm>
        <CommunicationStepSize>0.05</CommunicationStepSize>
        <Tolerance>0.0001</Tolerance>
    </Integration>
    <Log>
        <Enabled>true</Enabled>
        <Language>zh_cn</Language>
        <Category>logMessage</Category>
    </Log>
    <Options>
        <SaveResult>true</SaveResult>
        <SaveRealToDouble>true</SaveRealToDouble>
        <SaveEventPoint>false</SaveEventPoint>
    </Options>
    <SimulationScale>
        <SimMaximumVariables>1000000</SimMaximumVariables>
    </SimulationScale>
    <RealTime>
        <AllowStepOverrun>true</AllowStepOverrun>
        <SlowdownFactor>1</SlowdownFactor>
        <RealTimeBaseStep>false</RealTimeBaseStep>
        <OnlineParamsStep>false</OnlineParamsStep>
    </RealTime>
    <SteadyState>
        <SimMode>0</SimMode>
        <Tolerance>0.00001</Tolerance>
        <StartTime>0</StartTime>
    </SteadyState>
    <Discrete>false</Discrete>
    <AutoSaveResult>
        <Strategy>0</Strategy>
        <Value>0</Value>
    </AutoSaveResult>
    <IoTDB>
        <IoDBIp></IoDBIp>
        <IoDBPort></IoDBPort>
        <IoDBUser></IoDBUser>
        <IoDBPasswd></IoDBPasswd>
        <IoDBDiviceId></IoDBDiviceId>
        <IoDBMaxLine></IoDBMaxLine>
        <IoDBOutPath></IoDBOutPath>
        <IoDBThreadNum></IoDBThreadNum>
        <IoDBTableNum></IoDBTableNum>
    </IoTDB>
</Settings>
